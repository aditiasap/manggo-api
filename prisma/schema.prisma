generator client {
  provider = "prisma-client-js"
}

// Change DB to a more production-grade DB here, like Postgre or MySQL
datasource db {
  provider = "sqlite"
  url      = env("DBURL")
}

model sessions {
  id        String   @id @default(uuid())   // sessionId

  contents  contents[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model contents {
  id              String  @id @default(cuid())
  prompt          String
  style           String?
  originalPrompt  String?

  imageUrl      String?     // Cloudinary URL
  status        String      // queueing / generating / uploading / success / failed
  error         String?     // error string when failed

  sessionId     String
  session       sessions  @relation(fields: [sessionId], references: [id])

  createdAt     DateTime  @default(now())

  @@unique([id, sessionId])
}

